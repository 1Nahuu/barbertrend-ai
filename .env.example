# ==========================================================================
# BarberTrend AI — Variables de entorno
#
# INSTRUCCIONES
# 1. Copiá este archivo a "backend/.env":  cp .env.example backend/.env
#    (la aplicación se ejecuta desde backend/ y lee el .env de ahí)
# 2. Completá los valores reales.
# 3. NUNCA subas el archivo ".env" al repositorio (ya está en .gitignore).
#
# IMPORTANTE: todos los valores de abajo son de EJEMPLO y están rotulados
# como tales. No hay ninguna credencial real en este proyecto.
#
# Spring Boot lee este archivo con la instrucción:
#   spring.config.import=optional:file:.env[.properties]
# Por eso el formato es CLAVE=valor (sin comillas, sin "export").
# ==========================================================================

# --------------------------------------------------------------------------
# PERFIL DE EJECUCIÓN
# --------------------------------------------------------------------------
# dev  = base de datos H2 en archivo, datos de ejemplo, panel en /admin
# prod = PostgreSQL, exige credenciales reales
#
# Ojo con las mayúsculas: este archivo se lee como .properties, así que el
# perfil se escribe en minúsculas. La forma SPRING_PROFILES_ACTIVE solo
# funciona si la definís como variable de entorno del sistema.
spring.profiles.active=dev

# --------------------------------------------------------------------------
# BASE DE DATOS — solo necesaria en el perfil "prod"
# --------------------------------------------------------------------------
# La app NO arranca con estos valores: son inventados a propósito.
DB_URL=jdbc:postgresql://localhost:5432/barbertrend
DB_USERNAME=usuario_ejemplo
DB_PASSWORD=cambiar_esta_contrasena

# --------------------------------------------------------------------------
# PANEL DEL DUEÑO
# --------------------------------------------------------------------------
# Usuario del único administrador (panel /admin).
ADMIN_USERNAME=admin

# CONTRASEÑA: se guarda el hash BCrypt, NUNCA la contraseña en texto plano.
#
# El valor de abajo corresponde a la contraseña de ejemplo "cambiar-esto"
# (verificado). Para development podés dejarlo tal cual.
# Para producción tenés que generar tu propio hash. Cuando se implemente la
# Etapa 3 se agregará una utilidad para generarlo:
#   ./mvnw spring-boot:run -Dspring-boot.run.arguments=--app.hash-password=miClave
ADMIN_PASSWORD_HASH=$2a$12$VCmBO7CIfo/ZUQt7VTtEw.BSZtbB4im8CsFVpFv1WBRxZ1qWPirPm

# Alternativa SOLO para desarrollo. Si se usa esta variable, la aplicación
# avisa por log que la contraseña está en texto plano.
# ADMIN_PASSWORD=cambiar-esto

# --------------------------------------------------------------------------
# REGLAS DE LA AGENDA
# --------------------------------------------------------------------------
# Zona horaria de la barbería. Todos los horarios se calculan en esta zona.
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_CURRENCY=ARS
# Duración de cada bloque de la grilla de horarios, en minutos.
APP_SLOT_MINUTES=30
# Con cuánta anticipación mínima se puede reservar (minutos).
APP_MIN_LEAD_MINUTES=120
# Con cuántos días de anticipación máxima se puede reservar.
APP_MAX_ADVANCE_DAYS=60
# URL pública del sitio. En producción tiene que ser el dominio real.
APP_PUBLIC_BASE_URL=http://localhost:8080

# --------------------------------------------------------------------------
# LÍMITE DE INTENTOS DE RESERVA (rate limiting)
# --------------------------------------------------------------------------
# Evita que una misma IP llene la agenda con reservas falsas. Es una
# ventana fija en memoria: si se despliegan varias instancias, cada una
# lleva su propio conteo y hace falta un almacenamiento compartido.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BOOKING_MAX_ATTEMPTS=5
RATE_LIMIT_BOOKING_WINDOW_MINUTES=10
# El nombre comercial y la dirección se configuran en application.yml, que se
# lee como UTF-8. Si los pasás a este archivo, tené en cuenta que el .env se
# lee como ISO-8859-1: los acentos se rompen ("Barbería" -> "BarberÃ­a").
# Si necesitás ponerlos acá, escribí los acentos con escape: Doble S Barber\u00EDa

# --------------------------------------------------------------------------
# AVISOS POR EMAIL AL BARBERO
# --------------------------------------------------------------------------
# 100% gratis con Gmail:
#   1. Activá la verificación en dos pasos de tu cuenta de Google.
#   2. Creá una "Contraseña de aplicación" (Cuenta de Google > Seguridad).
#   3. Completá MAIL_USERNAME, MAIL_PASSWORD (la de 16 caracteres) y
#      BARBER_EMAIL con la casilla donde querés recibir los avisos.
#   4. Poné MAIL_ENABLED=true y reiniciá la aplicación.
#
# Mientras MAIL_ENABLED=false, la aplicación NO envía nada: escribe el aviso
# en el log (modo dry-run). Es el valor seguro por defecto.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=tu-cuenta@gmail.com
# Contraseña de aplicación de Gmail (16 caracteres), NO la contraseña normal
# de la cuenta. Dejala vacía mientras MAIL_ENABLED=false.
MAIL_PASSWORD=
# Remitente de los emails. Si queda vacío se usa MAIL_USERNAME.
MAIL_FROM=
# Casilla del barbero que recibe el aviso de cada turno nuevo.
BARBER_EMAIL=
# WhatsApp del barbero. Por ahora queda guardado para la etapa automática:
# el aviso al cliente se manda a mano desde el panel con un enlace wa.me.
# El valor de ejemplo es el número comercial que ya figura en el sitio.
BARBER_WHATSAPP=5492284239845

# --------------------------------------------------------------------------
# WHATSAPP (Etapa 4 — automático, todavía NO implementado)
# --------------------------------------------------------------------------
# En esta etapa el WhatsApp al cliente se manda a mano desde el panel con
# un enlace wa.me: es gratis y no necesita cuenta de Meta. Las variables de
# abajo son para la futura API oficial y quedan sin efecto por ahora.
# Configurarlas requiere una cuenta de Meta verificada.
# dry-run = registra el mensaje en el log y NO lo envía (comportamiento seguro).
# live    = envía de verdad. Solo con credenciales reales verificadas.
WHATSAPP_ENABLED=false
WHATSAPP_MODE=dry-run
# Versión de la Graph API. Verificar en la documentación oficial antes de usar.
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_ACCESS_TOKEN=token_de_ejemplo_no_valido
# Nombre de la plantilla de aprobación, registrado en la Meta Business Manager.
WHATSAPP_TEMPLATE_NAME=barbertrend_confirmacion_turno
# Destino de las recomendaciones del asistente de marketing.
WHATSAPP_OWNER_NUMBER=5491100000000

# --------------------------------------------------------------------------
# ASISTENTE DE MARKETING CON IA (Etapa 5 — todavía NO implementado)
# --------------------------------------------------------------------------
# La integración con el proveedor de IA es intercambiable a propósito.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
